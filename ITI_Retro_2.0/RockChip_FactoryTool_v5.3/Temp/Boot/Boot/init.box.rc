on post-fs
    insmod /system/lib/modules/vcodec_service.ko

on init
   write /proc/sys/vm/swappiness 100
   write /sys/block/zram0/comp_algorithm lz4

on boot
    # update foreground cpuset now that processors are up
    # reserve CPU 3 for the top app
    write /dev/cpuset/foreground/cpus 0-2
    write /dev/cpuset/foreground/boost/cpus 0-3
    write /dev/cpuset/background/cpus 0
    write /dev/cpuset/system-background/cpus 0-1
    write /dev/cpuset/top-app/cpus 0-3

    chmod 0660 /sys/devices/system/cpu/cpufreq/interactive/boostpulse
    chown system system /sys/devices/20001000.gpu/available_frequencies
    chmod 0660 /sys/devices/20001000.gpu/available_frequencies
    chown system system /sys/devices/20001000.gpu/clock
    chmod 0660 /sys/devices/20001000.gpu/clock
    chown system system /sys/devices/20001000.gpu/dvfs_enable
    chmod 0660 /sys/devices/20001000.gpu/dvfs_enable
    chmod 777 /proc/driver/ledtest/powerled

service rootservice /system/bin/rootsudaemon.sh
    user root
    group root
    disabled
    oneshot

on property:sys.boot_completed=1
    start rootservice
